# ==============================================================================
# GOKUL CONNECT — ENVIRONMENT CONFIGURATION (STANDALONE PROJECT)
# ==============================================================================
# IMPORTANT: Provide credentials from the dedicated Gokul Connect Supabase project.
# DO NOT use credentials from any prior projects.
# ==============================================================================

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Dedicated Supabase Project
NEXT_PUBLIC_SUPABASE_URL=https://your-dedicated-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_dedicated_supabase_anon_key

# Supabase Server-Side Secret Key (DO NOT expose to client)
SUPABASE_SERVICE_ROLE_KEY=your_dedicated_supabase_service_role_key

# Application Encryption Key (Server-only 32-byte / 64-hex AES-256-GCM secret - DO NOT expose to client)
APP_ENCRYPTION_SECRET=your_64_character_hex_encryption_secret

# Cron Worker Secret for /api/cron/process-automation-jobs (Bearer authorization - DO NOT expose to client)
CRON_SECRET=

# WhatsApp Cloud API (Dedicated Meta App - to be configured in Phase 3)
WHATSAPP_API_VERSION=v21.0
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
META_WEBHOOK_VERIFY_TOKEN=your_webhook_verify_token

# Test Account Credentials (used by verification scripts - DO NOT expose to client or commit secrets)
TEST_ASTROLOGY_USER_EMAIL=user_a_astro@example.com
TEST_ASTROLOGY_USER_PASSWORD=your_astrology_test_user_password
TEST_VIVAHAM_USER_EMAIL=user_b_vivaham@example.com
TEST_VIVAHAM_USER_PASSWORD=your_vivaham_test_user_password

